# Copy to .env on the server. Never commit the real file.
# A long random secret shared only with the website's server (Vercel). Make one with: openssl rand -hex 32
JARVIS_SERVER_KEY=
# The server's public hostname. Without a domain, use the IP with sslip.io, e.g. 140-238-12-34.sslip.io
DOMAIN=
# CPU threads for the mind (leave one or two for the voice).
MIND_THREADS=3
